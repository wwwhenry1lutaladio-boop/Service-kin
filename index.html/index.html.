
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#082f63">
<title>SERVICE KIN - Les professionnels à votre service à Kinshasa</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root {
  --blue:#082f63;
  --blue2:#104b89;
  --yellow:#ffc400;
  --light:#f3f6fb;
  --text:#17243a;
  --muted:#64748b;
  --green:#079447;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,sans-serif;background:var(--light);color:var(--text)}
button,input,select,textarea{font:inherit}
a{color:inherit}

header{
  background:white;padding:13px 5%;display:flex;align-items:center;
  justify-content:space-between;gap:15px;box-shadow:0 2px 12px #0000000c;
}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo-icon{
  width:50px;height:48px;display:grid;place-items:center;
  background:var(--blue);color:var(--yellow);border-radius:12px;
  font-size:29px;font-weight:bold;
}
.logo{font-size:27px;font-weight:900;color:var(--blue)}
.logo span{color:var(--yellow)}
.brand p{margin:2px 0 0;color:var(--muted);font-size:12px}
nav{display:flex;gap:17px}
nav a{text-decoration:none;font-size:13px;font-weight:bold;color:var(--blue)}
.header-actions{display:flex;gap:8px;flex-wrap:wrap}
.header-btn{
  text-decoration:none;border-radius:30px;padding:11px 15px;
  background:var(--blue);color:white;font-size:12px;font-weight:bold;
}
.header-btn.yellow{background:var(--yellow);color:#17243a}

.hero{
  background:radial-gradient(circle at 80% 30%,#287eb3 0,transparent 35%),
  linear-gradient(120deg,#062957,#104e8c);
  color:white;padding:60px 5%;
}
.hero-inner{
  max-width:1250px;margin:auto;display:grid;
  grid-template-columns:1.4fr .8fr;align-items:center;gap:30px;
}
.hero h1{font-size:clamp(34px,5vw,58px);line-height:1.08;margin:0 0 18px}
.hero h1 span{color:var(--yellow)}
.hero p{font-size:17px;line-height:1.6;color:#e4efff}
.hero-button{
  display:inline-block;margin-top:15px;background:var(--yellow);
  color:#15243a;text-decoration:none;font-weight:bold;
  padding:15px 24px;border-radius:30px;
}
.hero-visual{
  min-height:210px;border:1px solid #ffffff40;border-radius:24px;
  background:#ffffff12;display:flex;flex-direction:column;
  justify-content:center;align-items:center;text-align:center;padding:25px;
}
.hero-visual .symbol{font-size:70px}
.hero-visual strong{font-size:22px;color:var(--yellow)}
.hero-visual span{margin-top:9px;color:#e4efff;line-height:1.5}

main{max-width:1300px;margin:auto;padding:30px 22px}
.section-title{color:var(--blue);font-size:25px;margin:0 0 8px}
.section-intro{color:var(--muted);line-height:1.6;margin:0 0 20px}
.categories{
  display:grid;grid-template-columns:repeat(7,minmax(0,1fr));
  gap:10px;margin:20px 0;
}
.category-btn{
  background:white;border:1px solid #dce5f0;border-radius:13px;
  padding:14px 7px;color:var(--blue);font-size:12px;font-weight:bold;
  cursor:pointer;min-height:90px;
}
.category-btn .emoji{display:block;font-size:25px;margin-bottom:8px}
.category-btn.active{background:var(--blue);color:white;border-color:var(--blue)}

.search-box{
  display:flex;gap:10px;background:white;border:1px solid #dce5f0;
  border-radius:40px;padding:7px;margin:20px 0 30px;
}
.search-box input{flex:1;border:0;outline:0;padding:12px;min-width:0}
.search-box button{
  border:0;border-radius:30px;background:var(--blue);
  color:white;padding:0 22px;font-weight:bold;
}
.results-heading{display:flex;justify-content:space-between;gap:10px;margin-bottom:15px}
.results-heading h2{margin:0;color:var(--blue);font-size:23px}
.results-heading span{color:var(--blue2);font-size:13px}
.results-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:20px}
#results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.card{
  background:white;border-radius:16px;padding:18px;
  box-shadow:0 4px 15px #0000000c;border:1px solid #e6edf5;
}
.card .tag{
  display:inline-block;background:#e8f1ff;color:var(--blue2);
  font-size:12px;font-weight:bold;padding:6px 10px;border-radius:20px;
}
.card h3{color:var(--blue);font-size:19px;margin:12px 0 7px}
.card p{color:#526174;font-size:14px;line-height:1.5;margin:7px 0}
.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:13px}
.gallery img{width:100%;height:145px;object-fit:cover;border-radius:9px}
.photo-caption{font-size:12px!important;color:var(--muted)!important}
.contact{
  display:block;text-align:center;background:var(--green);color:white;
  text-decoration:none;padding:12px;border-radius:9px;
  font-weight:bold;font-size:14px;margin-top:15px;
}
.empty-message{
  grid-column:1/-1;background:white;padding:25px;
  border-radius:13px;color:var(--muted);text-align:center;
}
.side-card{
  background:linear-gradient(160deg,#07356e,#0b5796);
  color:white;padding:24px 19px;border-radius:17px;
  text-align:center;align-self:start;
}
.side-card .symbol{font-size:43px}
.side-card h3{font-size:22px}
.side-card p{font-size:14px;line-height:1.6;color:#e5efff}
.side-card a{
  display:block;background:var(--yellow);color:#17243a;
  text-decoration:none;padding:13px;border-radius:25px;
  font-weight:bold;margin-top:17px;
}
.form-section{
  margin-top:35px;background:white;border-radius:18px;
  padding:28px;box-shadow:0 4px 18px #00000009;
}
.form-section h2{color:var(--blue);margin:0 0 8px;font-size:24px}
.form-section form{margin-top:20px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
input,select,textarea{
  width:100%;padding:14px;border:1px solid #d5dfeb;
  border-radius:9px;font-size:15px;background:white;
  color:var(--text);margin:6px 0;
}
textarea{resize:vertical}
.submit{
  background:var(--yellow);color:#17243a;border:0;
  padding:14px 22px;border-radius:9px;font-weight:bold;
  cursor:pointer;margin-top:10px;
}
.note{font-size:13px;color:var(--muted);line-height:1.5}
.benefits{
  background:#e8f0fb;padding:25px 5%;display:flex;
  justify-content:center;flex-wrap:wrap;gap:25px;
  color:var(--blue);font-size:14px;font-weight:bold;
}
footer{background:#062957;color:white;padding:25px;text-align:center;font-size:13px}
footer strong{color:var(--yellow)}

@media(max-width:950px){
  nav{display:none}
  .categories{grid-template-columns:repeat(4,minmax(0,1fr))}
  .results-layout{grid-template-columns:1fr}
}
@media(max-width:600px){
  header{padding:12px;flex-wrap:wrap}
  .logo{font-size:23px}
  .logo-icon{width:42px;height:42px;font-size:24px}
  .brand p{font-size:10px}
  .header-btn{padding:10px;font-size:11px}
  .hero{padding:40px 18px}
  .hero-inner{grid-template-columns:1fr}
  .hero h1{font-size:35px}
  .hero p{font-size:15px}
  main{padding:22px 12px}
  .categories{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
  .category-btn{min-height:82px;font-size:11px;padding:9px 4px}
  .category-btn .emoji{font-size:22px}
  .search-box{border-radius:12px;gap:3px}
  .search-box input{padding:10px;font-size:13px}
  .search-box button{padding:0 12px;border-radius:8px;font-size:12px}
  #results{grid-template-columns:1fr}
  .form-section{padding:20px 14px}
  .form-grid{grid-template-columns:1fr}
}
</style>
</head>

<body>

<header>
  <a class="brand" href="#accueil">
    <div class="logo-icon">⌂</div>
    <div>
      <div class="logo">SERVICE <span>KIN</span></div>
      <p>Les professionnels à votre service à Kinshasa</p>
    </div>
  </a>

  <nav>
    <a href="#accueil">Accueil</a>
    <a href="#professionnels">Professionnels</a>
    <a href="#demande">Mes demandes</a>
    <a href="#apropos">À propos</a>
    <a href="#contact">Contact</a>
  </nav>

  <div class="header-actions">
    <a class="header-btn" href="espace-professionnel.html">Espace Pro</a>
    <a class="header-btn yellow" href="admin.html">Connexion</a>
  </div>
</header>

<section class="hero" id="accueil">
  <div class="hero-inner">
    <div>
      <h1>Trouvez le bon professionnel <span>à Kinshasa !</span></h1>
      <p>Découvrez des professionnels qualifiés pour vos travaux, vos achats et vos besoins quotidiens.</p>
      <a class="hero-button" href="#professionnels">⌕ Rechercher un service →</a>
    </div>
    <div class="hero-visual">
      <div class="symbol">🤝</div>
      <strong>Service Kin, c'est la confiance !</strong>
      <span>Une plateforme pour rapprocher les clients et les professionnels de Kinshasa.</span>
    </div>
  </div>
</section>

<main>
<section id="professionnels">
  <h2 class="section-title">Nos services</h2>
  <p class="section-intro">Choisissez une catégorie ou recherchez directement un professionnel.</p>
  <div class="categories" id="categories"></div>

  <div class="search-box">
    <input id="search" placeholder="Rechercher un métier, un professionnel ou un quartier...">
    <button type="button" onclick="document.getElementById('search').focus()">Rechercher</button>
  </div>

  <div class="results-heading">
    <h2>Nos professionnels à la une</h2>
    <span>Kinshasa, RDC</span>
  </div>

  <div class="results-layout">
    <div id="results">Chargement des professionnels...</div>
    <aside class="side-card">
      <div class="symbol">🤝</div>
      <h3>Vous êtes professionnel ?</h3>
      <p>Présentez votre activité dans SERVICE KIN et permettez à de nouveaux clients de vous découvrir.</p>
      <a href="espace-professionnel.html">Accéder à mon espace Pro →</a>
    </aside>
  </div>
</section>

<section class="form-section" id="demande">
  <h2>Faire une demande de service</h2>
  <p class="section-intro">Décrivez votre besoin. SERVICE KIN recevra votre demande.</p>
  <form id="demandeForm">
    <div class="form-grid">
      <input name="client_nom" placeholder="Votre nom complet" required>
      <input name="telephone" type="tel" placeholder="Votre numéro de téléphone ou WhatsApp" required>
      <input name="quartier" placeholder="Votre commune ou quartier" required>
      <select name="professionnel_id" id="choixProfessionnel">
        <option value="">Choisir un professionnel (facultatif)</option>
      </select>
    </div>
    <textarea name="description" placeholder="Décrivez le travail dont vous avez besoin..." rows="4" required></textarea>
    <button class="submit" type="submit">Envoyer ma demande →</button>
    <p id="demandeMessage" class="note"></p>
  </form>
</section>

<section class="form-section" id="inscription">
  <h2>Vous êtes professionnel ?</h2>
  <p class="section-intro">Inscrivez votre activité pour être visible auprès des clients de Kinshasa.</p>
  <form id="form">
    <div class="form-grid">
      <input name="name" placeholder="Votre nom ou entreprise" required>
      <select name="job" required>
        <option value="">Choisir votre métier</option>
        <option>Électricité</option>
        <option>Plomberie</option>
        <option>Maçonnerie</option>
        <option>Forage</option>
        <option>Géologie</option>
        <option>Ingénierie bâtiment</option>
        <option>Fournitures</option>
        <option>Staffeur en bâtiment</option>
        <option>Commerce en ligne</option>
        <option>Mode et accessoires féminins</option>
        <option>Photographie et production vidéo</option>
        <option>Marketing et communication</option>
        <option>Autre</option>
      </select>
      <input name="area" placeholder="Votre commune ou quartier" required>
      <input name="phone" type="tel" placeholder="Votre numéro WhatsApp" required>
    </div>
    <textarea name="services" placeholder="Décrivez vos services" rows="3"></textarea>
    <button class="submit" type="submit">Ajouter mon profil →</button>
    <p id="message" class="note"></p>
  </form>
</section>

<section id="apropos" class="form-section">
  <h2>À propos de SERVICE KIN</h2>
  <p class="section-intro">
    SERVICE KIN facilite la mise en relation entre les habitants de Kinshasa
    et les professionnels, commerçants et prestataires de services.
    Notre ambition : rendre les services plus accessibles et valoriser les talents locaux.
  </p>
</section>
</main>

<div class="benefits">
  <span>🛡️ Service accessible</span>
  <span>👥 Des professionnels locaux</span>
  <span>⚡ Mise en relation rapide</span>
  <span>📍 À Kinshasa, pour Kinshasa</span>
</div>

<footer id="contact">
  <strong>SERVICE KIN</strong> - Kinshasa, RDC
  <p>Ensemble, construisons une ville plus forte !</p>
  © SERVICE KIN - Tous droits réservés
  <p>
    <a href="admin-photos.html">Gestion des photos</a>
  </p>
</footer>

<script>
const SUPABASE_URL = "https://ikhjunfdqjnhonxisjeh.supabase.co";

/* CLÉ SUPABASE CORRIGÉE */
const SUPABASE_KEY = "sb_publishable_afY2FCUMd8FevvoqJ9rg_AvGeY0hE";

const photoClient = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const categories = [
  "Tous",
  "Électricité",
  "Plomberie",
  "Maçonnerie",
  "Forage",
  "Géologie",
  "Ingénierie bâtiment",
  "Fournitures",
  "Staffeur en bâtiment",
  "Commerce en ligne",
  "Mode et accessoires féminins",
  "Photographie et production vidéo",
  "Marketing et communication"
];

const categoryIcons = {
  "Tous":"🌟",
  "Électricité":"⚡",
  "Plomberie":"🚰",
  "Maçonnerie":"🧱",
  "Forage":"🔩",
  "Géologie":"⛰️",
  "Ingénierie bâtiment":"🏢",
  "Fournitures":"📦",
  "Staffeur en bâtiment":"🦺",
  "Commerce en ligne":"🛒",
  "Mode et accessoires féminins":"👗",
  "Photographie et production vidéo":"📷",
  "Marketing et communication":"📢"
};

let active = "Tous";
let professionnels = [];
let photosApprouvees = {};

const headers = {
  "apikey": SUPABASE_KEY,
  "Content-Type": "application/json"
};

function remplirCategories() {
  const cat = document.getElementById("categories");
  cat.replaceChildren();

  categories.forEach(c => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "category-btn" + (active === c ? " active" : "");

    const emoji = document.createElement("span");
    emoji.className = "emoji";
    emoji.textContent = categoryIcons[c];

    const texte = document.createElement("span");
    texte.textContent = c;

    btn.append(emoji, texte);

    btn.onclick = () => {
      active = c;
      afficher();
    };

    cat.appendChild(btn);
  });
}

function remplirChoixProfessionnels() {
  const select = document.getElementById("choixProfessionnel");
  const ancienneValeur = select.value;

  select.replaceChildren();

  const optionVide = document.createElement("option");
  optionVide.value = "";
  optionVide.textContent = "Choisir un professionnel (facultatif)";
  select.appendChild(optionVide);

  professionnels.forEach(p => {
    const option = document.createElement("option");
    option.value = p.id;
    option.textContent = `${p.nom} - ${p.metier} (${p.quartier || "Kinshasa"})`;
    select.appendChild(option);
  });

  select.value = ancienneValeur;
}

function afficher() {
  remplirCategories();

  const q = document.getElementById("search").value.toLowerCase();

  const liste = professionnels.filter(p => {
    const correspondCategorie = active === "Tous" || p.metier === active;
    const texte = `${p.nom || ""} ${p.metier || ""} ${p.quartier || ""} ${p.services || ""}`.toLowerCase();
    return correspondCategorie && texte.includes(q);
  });

  const results = document.getElementById("results");
  results.replaceChildren();

  if (!liste.length) {
    const vide = document.createElement("div");
    vide.className = "empty-message";
    vide.textContent = professionnels.length
      ? "Aucun professionnel trouvé pour cette recherche."
      : "Les professionnels seront affichés ici dès leur chargement.";
    results.appendChild(vide);
    return;
  }

  liste.forEach(p => {
    const card = document.createElement("div");
    card.className = "card";

    const tag = document.createElement("span");
    tag.className = "tag";
    tag.textContent = p.metier || "Professionnel";

    const title = document.createElement("h3");
    title.textContent = p.nom || "";

    const quartier = document.createElement("p");
    quartier.textContent = "📍 " + (p.quartier || "Kinshasa");

    const services = document.createElement("p");
    services.textContent = p.services || "";

    card.append(tag, title, quartier, services);

    const galerie = photosApprouvees[p.id] || [];

    if (galerie.length) {
      const titreGalerie = document.createElement("h4");
      titreGalerie.textContent = "Quelques réalisations";
      card.appendChild(titreGalerie);

      const grille = document.createElement("div");
      grille.className = "gallery";

      galerie.forEach(photo => {
        const bloc = document.createElement("div");
        const img = document.createElement("img");

        img.src = photo.url;
        img.alt = photo.description || "Réalisation de " + p.nom;
        img.loading = "lazy";

        bloc.appendChild(img);

        if (photo.description) {
          const legende = document.createElement("p");
          legende.className = "photo-caption";
          legende.textContent = photo.description;
          bloc.appendChild(legende);
        }

        grille.appendChild(bloc);
      });

      card.appendChild(grille);
    }

    if (p.telephone) {
      const contact = document.createElement("a");
      contact.className = "contact";
      contact.textContent = "WhatsApp : Contacter ce professionnel";
      contact.href = "https://wa.me/" + p.telephone.replace(/\D/g, "");
      contact.target = "_blank";
      contact.rel = "noopener";
      card.appendChild(contact);
    }

    results.appendChild(card);
  });
}

async function chargerPhotosApprouvees() {
  photosApprouvees = {};

  try {
    const response = await fetch(
      SUPABASE_URL +
      "/rest/v1/realisations?select=id,professionnel_id,photo_path,description&statut=eq.approuvee&order=created_at.desc",
      { headers }
    );

    if (!response.ok) {
      throw new Error("Erreur photos : " + response.status);
    }

    const photos = await response.json();

    for (const photo of photos) {
      const resultat = await photoClient.storage
        .from("realisations")
        .createSignedUrl(photo.photo_path, 3600);

      if (resultat.error || !resultat.data?.signedUrl) {
        console.error("Photo inaccessible :", resultat.error);
        continue;
      }

      if (!photosApprouvees[photo.professionnel_id]) {
        photosApprouvees[photo.professionnel_id] = [];
      }

      photosApprouvees[photo.professionnel_id].push({
        url: resultat.data.signedUrl,
        description: photo.description || ""
      });
    }
  } catch (error) {
    console.error("Chargement des photos impossible :", error);
  }
}

async function chargerProfessionnels() {
  const results = document.getElementById("results");

  try {
    const response = await fetch(
      SUPABASE_URL +
      "/rest/v1/professionnels?select=id,nom,metier,quartier,telephone,services",
      { headers }
    );

    if (!response.ok) {
      throw new Error("Erreur de chargement : " + response.status);
    }

    professionnels = await response.json();

    await chargerPhotosApprouvees();

    afficher();
    remplirChoixProfessionnels();

  } catch (error) {
    results.textContent =
      "Impossible de charger les professionnels. Vérifiez la connexion.";
    console.error(error);
  }
}

/* DEMANDES DES CLIENTS */
document.getElementById("demandeForm").addEventListener("submit", async e => {
  e.preventDefault();

  const form = e.target;
  const message = document.getElementById("demandeMessage");
  const d = Object.fromEntries(new FormData(form));

  message.textContent = "Envoi de votre demande en cours...";

  const nouvelleDemande = {
    client_nom: d.client_nom.trim(),
    telephone: d.telephone.trim(),
    quartier: d.quartier.trim(),
    description: d.description.trim(),
    professionnel_id: d.professionnel_id ? Number(d.professionnel_id) : null
  };

  try {
    const response = await fetch(
      SUPABASE_URL + "/rest/v1/demandes",
      {
        method: "POST",
        headers: {
          ...headers,
          "Prefer": "return=minimal"
        },
        body: JSON.stringify(nouvelleDemande)
      }
    );

    if (!response.ok) {
      throw new Error(await response.text());
    }

    message.textContent =
      "Votre demande a bien été envoyée. Merci de faire confiance à SERVICE KIN !";
    form.reset();

  } catch (error) {
    message.textContent = "Échec de l'envoi. Veuillez réessayer.";
    console.error(error);
  }
});

/* INSCRIPTION DES PROFESSIONNELS */
document.getElementById("form").addEventListener("submit", async e => {
  e.preventDefault();

  const message = document.getElementById("message");
  const form = e.target;
  const d = Object.fromEntries(new FormData(form));

  message.textContent = "Enregistrement en cours...";

  const nouveauProfil = {
    nom: d.name.trim(),
    metier: d.job,
    quartier: d.area.trim(),
    telephone: d.phone.trim(),
    services: d.services.trim()
  };

  try {
    const response = await fetch(
      SUPABASE_URL + "/rest/v1/professionnels",
      {
        method: "POST",
        headers: {
          ...headers,
          "Prefer": "return=minimal"
        },
        body: JSON.stringify(nouveauProfil)
      }
    );

    if (!response.ok) {
      throw new Error(await response.text());
    }

    message.textContent = "Votre profil a été enregistré avec succès !";
    form.reset();
    active = "Tous";
    await chargerProfessionnels();

  } catch (error) {
    message.textContent =
